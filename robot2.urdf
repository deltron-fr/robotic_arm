<robot name="robot_arm">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.09 0.09 0.03"/></geometry>
      <material name="green"><color rgba="0.0 1.0 0.0 1.0"/></material>
    </visual>
  </link>

  <link name="base_rot">
    <visual>
      <origin xyz="0 0 0.023" rpy="0 0 0"/>
      <geometry><box size="0.02 0.04 0.046"/></geometry>
      <material name="green"><color rgba="0.0 1.0 0.0 1.0"/></material>
    </visual>
  </link>

  <joint name="base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="base_rot"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="arm1">
    <visual>
      <origin xyz="0 0 0.052" rpy="0 0 0"/>
      <geometry><cylinder length="0.105" radius="0.013"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_rot"/>
    <child link="arm1"/>
    <origin xyz="0 0 0.046" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="3.14159" effort="2.0" velocity="2.0"/>
  </joint>

  <link name="arm2">
    <visual>
      <origin xyz="0 0 0.063" rpy="0 0 0"/>
      <geometry><cylinder length="0.126" radius="0.008"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
    </visual>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="arm1"/>
    <child link="arm2"/>
    <origin xyz="0 0 0.105" rpy="-1.5708 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="2.0"/>
  </joint>

  <link name="arm3">
    <visual>
      <origin xyz="0 0 0.0265" rpy="0 0 0"/>
      <geometry><cylinder length="0.053" radius="0.022"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
    </visual>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="arm2"/>
    <child link="arm3"/>
    <origin xyz="0 0 0.126" rpy="-1.5708 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="2.0"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.01"/></geometry>
      <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>

  <joint name="gripper_rotation" type="revolute">
    <parent link="arm3"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.053" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="left_finger">
    <visual>
      <origin xyz="0.025 0 0.028" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.05"/></geometry>
      <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>

  <link name="right_finger">
    <visual>
      <origin xyz="-0.025 0 0.028" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.05"/></geometry>
      <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="left_finger"/>
    <origin xyz="0.025 0 0.005" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.02" effort="10.0" velocity="0.1"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="right_finger"/>
    <origin xyz="-0.025 0 0.005" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.02" effort="10.0" velocity="0.1"/>
  </joint>

</robot>